{
  "name": "cf-shortlink",
  "version": "1.0.0",
  "private": true,
  "description": "Cloudflare Workers 短链接生成器（D1 + KV + 深色后台 /x7k2m9）",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "db:create": "wrangler d1 create cf-shortlink",
    "db:migrate:local": "wrangler d1 execute cf-shortlink --local --file=./migrations/0001_init.sql",
    "db:migrate:remote": "wrangler d1 execute cf-shortlink --remote --file=./migrations/0001_init.sql",
    "kv:create": "wrangler kv namespace create SL_CACHE",
    "typecheck": "tsc --noEmit",
    "hash-password": "node scripts/hash-password.mjs",
    "set-password": "node scripts/set-password.mjs",
    "set-path": "node scripts/set-path.mjs",
    "gen-secret": "node -e \"console.log(require('node:crypto').randomBytes(32).toString('hex'))\""
  },
  "dependencies": {
    "hono": "^4.6.14"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261123.1",
    "typescript": "^5.7.2",
    "wrangler": "^4.168.0"
  }
}