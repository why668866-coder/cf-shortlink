{
  //:schema node_modules/wrangler/config-schema.json
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "cf-shortlink",
  "main": "src/index.ts",
  "compatibility_date": "2026-01-01",

  // ─────────────────────────────────────────────────────────────
  // 1) D1 数据库（存链接元数据 + 点击计数）
  //    创建：npm run db:create
  //    然后把输出里的 database_id 填到下面
  // ─────────────────────────────────────────────────────────────
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "cf-shortlink",
      "database_id": "REPLACE_WITH_YOUR_D1_DATABASE_ID"
    }
  ],

  // ─────────────────────────────────────────────────────────────
  // 2) KV 命名空间（跳转缓存）
  //    创建：npm run kv:create
  //    然后把输出里的 id 填到下面
  // ─────────────────────────────────────────────────────────────
  "kv_namespaces": [
    {
      "binding": "SL_CACHE",
      "id": "REPLACE_WITH_YOUR_KV_NAMESPACE_ID"
    }
  ],

  // ─────────────────────────────────────────────────────────────
  // 3) 环境变量
  //    ADMIN_PASSWORD_HASH：node scripts/hash-password.mjs "你的强密码"
  //    SESSION_SECRET：openssl rand -hex 32
  //    本地开发请写进 .dev.vars（见 README），不要写在这里
  // ─────────────────────────────────────────────────────────────
  "vars": {
    "ADMIN_PASSWORD_HASH": "REPLACE_WITH_SHA256_HEX",
    "SESSION_SECRET": "REPLACE_WITH_LONG_RANDOM_SECRET"
  },

  // ─────────────────────────────────────────────────────────────
  // 4) 可选：绑定自定义域名（推荐）
  //    "routes": [{ "pattern": "s.example.com/*", "zone_name": "example.com" }]
  // ─────────────────────────────────────────────────────────────

  // ─────────────────────────────────────────────────────────────
  // 5) 静态资源（后台样式表）
  // ─────────────────────────────────────────────────────────────
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/x7k2m9", "/x7k2m9/*", "/api/*", "/healthz"]
  },

  "observability": { "enabled": true }
}